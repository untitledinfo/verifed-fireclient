{
  "name": "fireclient-desktop",
  "productName": "FireClient",
  "version": "2.2.7",
  "description": "FireClient — Cross-Platform Minecraft Launcher & Server Host for macOS, Linux, and Windows",
  "main": "main.js",
  "author": "FireClient LLC <support@fireclient.net>",
  "license": "MIT",
  "homepage": "https://fireclient.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/untitledinfo/verifed-fireclient.git"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:mac:universal": "electron-builder --mac dmg zip --universal --publish never",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz --publish never",
    "dist:win": "electron-builder --win nsis zip --publish never"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "net.fireclient.launcher",
    "productName": "FireClient",
    "copyright": "Copyright © 2026 FireClient LLC",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*",
          "!**/*.bak*"
        ]
      },
      {
        "from": "../assets",
        "to": "assets"
      },
      {
        "from": "../bundled-mods",
        "to": "bundled-mods",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "../assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64",
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "FireClient-macOS-${arch}.${ext}"
    },
    "dmg": {
      "title": "FireClient ${version}",
      "icon": "../assets/icon.png",
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 145,
          "y": 190
        },
        {
          "x": 415,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "category": "Game",
      "synopsis": "High-Performance Minecraft Launcher & Server Host",
      "description": "FireClient is a fast, cross-platform Minecraft Java launcher with automatic Java provisioning, Modrinth integration, and 1-click PaperMC server hosting.",
      "maintainer": "FireClient LLC <support@fireclient.net>",
      "icon": "../assets/icon.png",
      "executableName": "fireclient",
      "desktop": {
        "Name": "FireClient",
        "Comment": "High-Performance Minecraft Launcher & Server Host",
        "Categories": "Game;",
        "StartupWMClass": "FireClient",
        "Keywords": "minecraft;launcher;fabric;forge;modrinth;fireclient;"
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "FireClient-Linux-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  }
}
